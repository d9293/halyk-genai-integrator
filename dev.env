# Local development. Variables already set in the environment override these.
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=10s
SWAGGER_ENABLED=true

# Auth is deferred; every BPM request is attributed to this caller.
CALLER_ID=bpm

# Comma-separated. Implemented: SOCIAL_MEDIA, REGISTER_COMPARE.
ENABLED_OPERATIONS=SOCIAL_MEDIA,REGISTER_COMPARE
# Comma-separated hosts accepted in documents[].attstoreUrl.
ATTSTORE_ALLOWED_HOSTS=attstore.example

# How long worker.Request owns a claimed document without renewing it.
DOCUMENT_CLAIM_LEASE=60s
# A failed copy is retried after 5s, 10s, 20s, ... up to 5m; after 5 failures
# the document and its task need attention.
DOCUMENT_MAX_COPY_ATTEMPTS=5
DOCUMENT_RETRY_BASE_DELAY=5s
DOCUMENT_RETRY_MAX_DELAY=5m

# How long worker.Request owns a POST to AI in progress without renewing it.
SUBMISSION_CLAIM_LEASE=60s
# How many tasks may be at AI at once: being sent, queued or running there.
AI_MAX_IN_FLIGHT=10
# First status check of a task this long after it was sent to AI.
SUBMISSION_POLL_DELAY=15s

# How long worker.Response owns one status check (a single GET to AI).
POLL_CLAIM_LEASE=30s
# Next status check after QUEUED/PROCESSING: 15s ± 5s.
POLL_INTERVAL=15s
POLL_INTERVAL_JITTER=5s
# Next status check after AI said it does not know the task.
POLL_NOT_FOUND_DELAY=30s
# Next status check after a timeout or other technical error.
POLL_ERROR_DELAY=60s
# A task is lost after 3 NOT_FOUND in a row over at least 60s; it is then
# sent again, at most 3 times.
LOST_TASK_NOT_FOUND_THRESHOLD=3
LOST_TASK_MIN_WINDOW=60s
MAX_RESUBMISSIONS=3
# Biggest AI result stored (512 KiB); a bigger one needs attention.
RESULT_MAX_BYTES=524288

# Kafka topic for final task results (BPM consumes it).
KAFKA_RESULT_TOPIC=integrator.task-results.v1
# How long worker.Response owns one result while publishing it.
RESULT_CLAIM_LEASE=30s

# Local infra Postgres: the default database, where schema "integration" lives.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_QUERY_TIMEOUT=5s
